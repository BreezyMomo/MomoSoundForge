{
  "name": "momo-sound-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node tools/build-builtin-library.mjs && node tools/build-ai-skill.mjs",
    "dev": "vite --host 127.0.0.1 --port 5180",
    "prebuild": "node tools/build-builtin-library.mjs && node tools/build-ai-skill.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4180",
    "test": "vitest run --project unit",
    "ai:build": "node tools/build-ai-skill.mjs",
    "ai:serve": "node tools/ai-server.mjs",
    "audit:sources": "node tools/review-sound-sources.mjs",
    "audit:inventory": "node tools/inventory-sound-assets.mjs",
    "audit:instruments": "node tools/diagnose-instruments.mjs",
    "audit:restore-mappings": "node tools/restore-author-mappings.mjs",
    "test:assets": "node tools/sound-assets.mjs verify && node tools/build-builtin-library.mjs && vitest run --project assets",
    "test:provenance": "node tools/sound-assets.mjs verify --profile audit && node tools/build-builtin-library.mjs && vitest run --project provenance",
    "assets:pack": "node tools/sound-assets.mjs pack",
    "assets:sync": "node tools/sound-assets.mjs sync",
    "assets:verify": "node tools/sound-assets.mjs verify",
    "assets:status": "node tools/sound-assets.mjs status"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@fontsource/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@momo/workbench": "file:vendor/momo-workbench-0.7.0.tgz",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.7",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.5"
  }
}
