{
  "name": "momo-sound-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node tools/build-builtin-library.mjs",
    "dev": "vite --host 127.0.0.1 --port 5180",
