    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "fake-indexeddb": "^6.2.7",
    "typescript": "~5.9.2",
